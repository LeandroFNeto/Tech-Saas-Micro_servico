{
  "name": "baileys-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Gateway WhatsApp com Baileys, com a API REST e o webhook que o backend Java consome",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "6.7.24",
    "express": "4.22.3",
    "pino": "9.14.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "type": "module"
}
