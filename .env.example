# ==========================================
# BANCO DE DADOS (POSTGRESQL 17) — lido pelo docker-compose
# O compose cria o Postgres e injeta as mesmas credenciais no Java.
# Não use root. Troque a senha placeholder antes de subir.
# ==========================================
MEU_POSTGRES_USER=postgres
MEU_POSTGRES_PASSWORD=sua_senha_do_banco_aqui
MEU_POSTGRES_DB=bot_db

# ==========================================
# 🔒 SEGURANÇA E WEBHOOK (WPPCONNECT)
# ==========================================
# Mesmo valor do secretKey do WPPConnect (padrão: THISISMYSECURETOKEN)
WPP_SECRET_KEY=THISISMYSECURETOKEN
WPPCONNECT_SECRET_KEY=THISISMYSECURETOKEN
WPPCONNECT_WEBHOOK_URL=http://bot-java:8080/webhook/whatsapp
# Token de autorização para blindar a sua API contra requisições falsas ("X9")
API_AUTH_TOKEN=seu_token_de_seguranca_da_api_aqui
# Mesmo valor de frontend/src/environments/environment.ts (adminApiKey)
ADMIN_API_KEY=sua-chave-admin
JWT_SECRET_KEY=SuaChaveSuperSecretaParaGerarOsTokensJWTDe32Caracteres
ADMIN_DEFAULT_EMAIL=usuario@gamb.com
ADMIN_DEFAULT_PASSWORD=SenhaMaster123
# Origem do frontend na Vercel (vírgula se houver mais de uma, ex.: produção + localhost)
CORS_ALLOWED_ORIGINS=https://seu-app.vercel.app

# ==========================================
# 📅 GOOGLE CALENDAR
# ==========================================
# Caminho ou ID da agenda (conforme sua lógica de credenciais do Google)
GOOGLE_CALENDAR_ID=Seu id aki

# ==========================================
# 🧠 INTELIGÊNCIA ARTIFICIAL (NOVO - PASSO 1.2)
# ==========================================
# Chave da API do Google Gemini (1.5 Flash)
GEMINI_API_KEY=sua_chave_aqui_gerada_no_google_ai_studio