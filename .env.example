# ==========================================
# BANCO DE DADOS (POSTGRESQL 17) — lido pelo docker-compose
# O compose cria o Postgres e injeta as mesmas credenciais no Java.
# Não use root. Troque a senha placeholder antes de subir.
# ==========================================
MEU_POSTGRES_USER=postgres
MEU_POSTGRES_PASSWORD=sua_senha_do_banco_aqui
MEU_POSTGRES_DB=bot_db

# ==========================================
# 🔒 SEGURANÇA E WEBHOOK (GATEWAY)
# ==========================================
# Segredo da API do gateway. Use 32 caracteres aleatórios ou mais.
WPP_SECRET_KEY=gere_um_segredo_da_api_do_gateway_com_32_caracteres_ou_mais
WPPCONNECT_SECRET_KEY=gere_um_segredo_da_api_do_gateway_com_32_caracteres_ou_mais
# Segredo do cabecalho x-webhook-token (gateway para Java). Use um valor diferente de WPP_SECRET_KEY.
WPPCONNECT_WEBHOOK_SECRET=gere_um_segredo_do_webhook_diferente_do_da_api_com_32_caracteres_ou_mais
WPPCONNECT_WEBHOOK_URL=http://bot-java:8080/webhook/whatsapp
WPPCONNECT_ON_SELF_MESSAGE=true
# Gateway Baileys (docker-compose: servico baileys-gateway, sem porta no host).
# URL que o Java usa para falar com o gateway
WPPCONNECT_URL=http://baileys-gateway:21465
# "Digitando..." antes de cada resposta do bot
BAILEYS_SIMULAR_DIGITACAO=true
# Hosts permitidos para baixar fotos da galeria (separados por virgula). Vazio: qualquer host publico.
BAILEYS_HOSTS_FOTO_PERMITIDOS=
BAILEYS_HOSTS_WEBHOOK_PERMITIDOS=
# Busca a versao atual do WhatsApp Web ao conectar (use true se o pareamento falhar com erro de versao)
BAILEYS_BUSCAR_VERSAO_WA=false
# Token de autorização para blindar a sua API contra requisições falsas ("X9")
API_AUTH_TOKEN=seu_token_de_seguranca_da_api_aqui
# Mesmo valor de frontend/src/environments/environment.ts (adminApiKey)
ADMIN_API_KEY=sua-chave-admin
# Obrigatória: a aplicação não sobe sem ela. 32 bytes ou mais, aleatórios.
JWT_SECRET_KEY=troque_por_uma_chave_aleatoria_de_32_bytes_ou_mais
ADMIN_DEFAULT_EMAIL=usuario@gamb.com
# Vazia: o admin inicial não é criado. Menos de 12 caracteres: a aplicação não sobe.
ADMIN_DEFAULT_PASSWORD=troque_por_uma_senha_de_12_caracteres_ou_mais
# Origem do frontend na Vercel (vírgula se houver mais de uma, ex.: produção + localhost)
CORS_ALLOWED_ORIGINS=https://seu-app.vercel.app
# Documentação da API (Swagger). Deixe false em produção.
SWAGGER_HABILITADO=false
# IPs ou CIDR dos proxies cujo X-Forwarded-For é aceito (vírgula para mais de um). Vazio: usa o IP da conexão.
PROXIES_CONFIAVEIS=172.18.0.0/16
# Uso único no deploy: bloqueia contas de cliente que ainda usam esta senha antiga. Remova do ambiente depois.
SENHA_LEGADA_A_BLOQUEAR=
# Número comercial da Gamb com DDI e DDD, só dígitos. Vazio: a resposta sai sem o link do WhatsApp.
GAMB_CONTATO_WHATSAPP=5511900000000

# ==========================================
# 📅 GOOGLE CALENDAR
# ==========================================
# Caminho ou ID da agenda (conforme sua lógica de credenciais do Google)
GOOGLE_CALENDAR_ID=Seu id aki

# ==========================================
# 🧠 INTELIGÊNCIA ARTIFICIAL (NOVO - PASSO 1.2)
# ==========================================
# Chave da API do Google Gemini (1.5 Flash)
GEMINI_API_KEY=sua_chave_aqui_gerada_no_google_ai_studio


# ==========================================
# PREVISAO DO TEMPO (OPENWEATHER, One Call 3.0)
# ==========================================
# Chave da API do OpenWeather. So o back usa; nunca vai para o front. Limite diario da conta em 1000 chamadas.
OPENWEATHER_API_KEY=sua_chave_do_openweather_aqui

# ==========================================
# PROTEÇÃO DE DADOS DE CONTATOS E RETENÇÃO
# ==========================================
# Chave de criptografia AES-256 (32 bytes em base64) e HMAC-SHA256 para busca indexada
CONTATOS_CHAVE_CRIPTO=sua_chave_aes_256_base64_aqui
CONTATOS_CHAVE_INDICE=sua_chave_hmac_sha256_aqui
RETENCAO_MESES=12
